<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.AdminMapper">
    <resultMap id="AdminMap" type="com.example.demo.model.Admin">
        <id column="admin_id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="admin_level" property="adminLevel"/>

        <!-- 关联用户信息 -->
        <association property="user" javaType="com.example.demo.model.User">
            <id column="user_id" property="id"/>
            <result column="username" property="username"/>
            <result column="email" property="email"/>
            <result column="password" property="password"/>
            <result column="role" property="role"/>
        </association>
    </resultMap>

    <!-- 确保查询包含所有必要字段 -->
    <select id="selectByUsername" resultMap="AdminMap">
        SELECT
        a.id AS admin_id,
        a.user_id,
        a.admin_level,
        u.id AS user_id, <!-- 添加别名避免冲突 -->
        u.username,
        u.email,
        u.password,
        u.role
        FROM admins a
        JOIN users u ON a.user_id = u.id
        WHERE u.username = #{username}
    </select>

    <select id="selectAdmins" resultMap="AdminMap">
        SELECT
        a.id AS admin_id,
        a.user_id,
        a.admin_level
        FROM admins a
    </select>

    <insert id="insertAdmin" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO admins (user_id, admin_level)
        VALUES (#{userId}, #{adminLevel})
    </insert>

    <select id="selectAdminById" resultMap="AdminMap">
        SELECT * FROM admins WHERE id = #{id}
    </select>

    <delete id="deleteAdminById">
        DELETE FROM admins WHERE id = #{id}
    </delete>

    <update id="updateAdmin">
        UPDATE admins
        SET user_id = #{userId},
        admin_level = #{adminLevel} <!-- 移除多余的逗号 -->
        WHERE id = #{id}
    </update>

    <select id="selectByUserId" resultMap="AdminMap">
        SELECT * FROM admins WHERE user_id = #{userId}
    </select>

    <delete id="deleteByUserId">
        DELETE FROM admins WHERE user_id = #{userId}
    </delete>

</mapper>