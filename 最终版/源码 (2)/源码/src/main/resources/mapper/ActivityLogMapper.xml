<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.ActivityLogMapper">

    <resultMap id="ActivityLogMap" type="com.example.demo.model.ActivityLog">
        <id     column="id"          property="id"/>
        <result column="user_id"     property="userId"/>
        <result column="action_type" property="actionType"/>
        <result column="target_type" property="targetType"/>
        <result column="target_id"   property="targetId"/>
        <result column="description" property="description"/>
        <result column="action_time" property="actionTime"/>
    </resultMap>

    <!-- 主键自增回填 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO activity_logs
        (user_id, action_type, target_type, target_id, description, action_time)
        VALUES
        (#{userId}, #{actionType}, #{targetType}, #{targetId}, #{description}, #{actionTime})
    </insert>

    <!-- 按时间倒序取最近 limit 条 -->
    <select id="selectRecent" resultMap="ActivityLogMap">
        SELECT *
        FROM activity_logs
        ORDER BY action_time DESC
        LIMIT #{limit}
    </select>

    <!-- 分页查询 - 修复路径和排序字段 -->
    <select id="selectPage" resultMap="ActivityLogMap">
        SELECT *
        FROM activity_logs
        ORDER BY action_time DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- 总记录数 -->
    <select id="count" resultType="long">
        SELECT COUNT(*)
        FROM activity_logs
    </select>

</mapper>